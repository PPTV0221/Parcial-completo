<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <appSettings>
    <!-- Validadores clásicos de ASP.NET sin necesidad de jQuery -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>

  <connectionStrings>
    <!-- SQL Server Express (por defecto) -->
    <add name="PawCareDB"
         connectionString="Server=.\SQLEXPRESS;Database=PawCareDB;Integrated Security=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
    <!-- Si usas LocalDB, reemplaza el Server por: (localdb)\MSSQLLocalDB -->
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <pages controlRenderingCompatibilityVersion="4.0" />
  </system.web>

</configuration>
